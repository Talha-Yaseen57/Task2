@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="About Devixo Solutions - Learn more about our mission, vision, and the team building modern digital solutions.">
    <title>About Us | Devixo Solutions</title>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <a href="/Home/Index" class="logo">
                <i class="fa-solid fa-code"></i>
                Devixo Solutions
            </a>
            <div class="nav-links">
                <a href="/Home/Index">Home</a>
                <a href="/Home/About">About</a>
                <a href="/Home/Services">Services</a>
                <a href="/Home/Portfolio">Portfolio</a>
                <a href="/Home/Contact">Contact</a>
            </div>
            <div class="nav-actions">
                <button class="theme-toggle" aria-label="Toggle Theme">
                    <i class="fa-solid fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" aria-label="Menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="section" style="background-color: var(--color-bg-white); border-bottom: 1px solid var(--color-border); padding: 4rem 0;">
        <div class="container text-center">
            <h1>About Devixo Solutions</h1>
            <p style="max-width: 600px; margin: 0 auto;">Devixo Solutions is a forward-thinking digital solutions company focused on building modern, scalable and user-friendly digital experiences.</p>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="section">
        <div class="container">
            <div class="grid" style="align-items: center;">
                <div>
                    <h2>Our Mission & Vision</h2>
                    <p><strong>Mission:</strong> To empower businesses through innovative technology solutions that drive sustainable growth and operational excellence.</p>
                    <p><strong>Vision:</strong> To become a globally recognized leader in digital transformation, setting new standards for quality, user experience, and technological advancement.</p>
                </div>
                <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="card" style="padding: 1.5rem; text-align: center;">
                        <i class="fa-solid fa-lightbulb" style="font-size: 2rem; color: var(--color-primary); margin-bottom: 1rem;"></i>
                        <h4>Innovation</h4>
                    </div>
                    <div class="card" style="padding: 1.5rem; text-align: center;">
                        <i class="fa-solid fa-award" style="font-size: 2rem; color: var(--color-primary); margin-bottom: 1rem;"></i>
                        <h4>Quality</h4>
                    </div>
                    <div class="card" style="padding: 1.5rem; text-align: center;">
                        <i class="fa-solid fa-handshake" style="font-size: 2rem; color: var(--color-primary); margin-bottom: 1rem;"></i>
                        <h4>Integrity</h4>
                    </div>
                    <div class="card" style="padding: 1.5rem; text-align: center;">
                        <i class="fa-solid fa-users" style="font-size: 2rem; color: var(--color-primary); margin-bottom: 1rem;"></i>
                        <h4>Collaboration</h4>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="section" style="background-color: var(--color-bg-white);">
        <div class="container">
            <div class="text-center" style="margin-bottom: 3rem;">
                <h2>Why Choose Us?</h2>
                <p>We deliver excellence across every aspect of your project.</p>
            </div>
            <div class="grid">
                <div class="card">
                    <i class="fa-solid fa-rocket card-icon"></i>
                    <h3>Fast Delivery</h3>
                    <p>We respect your deadlines and deliver high-quality products within the agreed timeframe.</p>
                </div>
                <div class="card">
                    <i class="fa-solid fa-headset card-icon"></i>
                    <h3>24/7 Support</h3>
                    <p>Our dedicated support team is always available to help you resolve any issues.</p>
                </div>
                <div class="card">
                    <i class="fa-solid fa-shield-halved card-icon"></i>
                    <h3>Secure & Reliable</h3>
                    <p>We build with security-first architecture, ensuring your data is always protected.</p>
                </div>
                <div class="card">
                    <i class="fa-solid fa-magnifying-glass-chart card-icon"></i>
                    <h3>SEO Optimized</h3>
                    <p>Our solutions are built with best practices to ensure high visibility on search engines.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Animated Counters -->
    <section class="stats">
        <div class="container">
            <div class="grid">
                <div>
                    <div class="stat-number" data-target="50">0</div>
                    <div class="stat-text">Projects Completed</div>
                </div>
                <div>
                    <div class="stat-number" data-target="30">0</div>
                    <div class="stat-text">Happy Clients</div>
                </div>
                <div>
                    <div class="stat-number" data-target="5">0</div>
                    <div class="stat-text">Years Experience</div>
                </div>
                <div>
                    <div class="stat-number" data-target="15">0</div>
                    <div class="stat-text">Team Members</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="section">
        <div class="container">
            <div class="text-center" style="margin-bottom: 3rem;">
                <h2>Meet Our Team</h2>
                <p>The talented people behind Devixo Solutions.</p>
            </div>
            <div class="grid">
                <div class="card text-center" style="padding: 2rem 1rem;">
                    <div style="width: 120px; height: 120px; border-radius: 50%; background-color: var(--color-border); margin: 0 auto 1.5rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Alex+Morgan&background=6C63FF&color=fff&size=120" alt="Alex Morgan">
                    </div>
                    <h3>Alex Morgan</h3>
                    <p style="color: var(--color-primary); font-weight: 500; margin-bottom: 0.5rem;">CEO & Founder</p>
                    <p style="font-size: 0.9rem;">Visionary leader guiding Devixo's strategy and growth.</p>
                </div>
                <div class="card text-center" style="padding: 2rem 1rem;">
                    <div style="width: 120px; height: 120px; border-radius: 50%; background-color: var(--color-border); margin: 0 auto 1.5rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Sarah+Khan&background=22C55E&color=fff&size=120" alt="Sarah Khan">
                    </div>
                    <h3>Sarah Khan</h3>
                    <p style="color: var(--color-primary); font-weight: 500; margin-bottom: 0.5rem;">UI/UX Designer</p>
                    <p style="font-size: 0.9rem;">Crafting intuitive and engaging user experiences.</p>
                </div>
                <div class="card text-center" style="padding: 2rem 1rem;">
                    <div style="width: 120px; height: 120px; border-radius: 50%; background-color: var(--color-border); margin: 0 auto 1.5rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Daniel+Ahmed&background=6C63FF&color=fff&size=120" alt="Daniel Ahmed">
                    </div>
                    <h3>Daniel Ahmed</h3>
                    <p style="color: var(--color-primary); font-weight: 500; margin-bottom: 0.5rem;">Full Stack Developer</p>
                    <p style="font-size: 0.9rem;">Architecting robust and scalable software solutions.</p>
                </div>
                <div class="card text-center" style="padding: 2rem 1rem;">
                    <div style="width: 120px; height: 120px; border-radius: 50%; background-color: var(--color-border); margin: 0 auto 1.5rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Emma+Wilson&background=22C55E&color=fff&size=120" alt="Emma Wilson">
                    </div>
                    <h3>Emma Wilson</h3>
                    <p style="color: var(--color-primary); font-weight: 500; margin-bottom: 0.5rem;">Project Manager</p>
                    <p style="font-size: 0.9rem;">Ensuring seamless execution and timely delivery.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="logo" style="margin-bottom: 1rem;">
                        <i class="fa-solid fa-code"></i> Devixo Solutions
                    </div>
                    <p>Digital Solutions. Powerful Results.</p>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem;">Quick Links</h4>
                    <ul style="display:flex; flex-direction:column; gap:0.5rem;">
                        <li><a href="/Home/Index">Home</a></li>
                        <li><a href="/Home/About">About Us</a></li>
                        <li><a href="/Home/Services">Services</a></li>
                        <li><a href="/Home/Portfolio">Portfolio</a></li>
                        <li><a href="/Home/Contact">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem;">Contact Info</h4>
                    <ul style="display:flex; flex-direction:column; gap:0.5rem; color:var(--color-text-muted);">
                        <li><i class="fa-solid fa-envelope"></i> hello@devixosolutions.com</li>
                        <li><i class="fa-solid fa-phone"></i> +92 300 1234567</li>
                        <li><i class="fa-solid fa-location-dot"></i> Lahore, Pakistan</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Devixo Solutions. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scroll to Top -->
    <button class="scroll-top" aria-label="Scroll to top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="/js/script.js"></script>
</body>
</html>

