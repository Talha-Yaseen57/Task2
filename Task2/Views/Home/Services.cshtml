@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Services by Devixo Solutions - We offer web development, UI/UX design, E-commerce development, and digital marketing.">
    <title>Our Services | Devixo Solutions</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <a href="/Home/Index" class="logo">
                <i class="fa-solid fa-code"></i>
                Devixo Solutions
            </a>
            <div class="nav-links">
                <a href="/Home/Index">Home</a>
                <a href="/Home/About">About</a>
                <a href="/Home/Services">Services</a>
                <a href="/Home/Portfolio">Portfolio</a>
                <a href="/Home/Contact">Contact</a>
            </div>
            <div class="nav-actions">
                <button class="theme-toggle" aria-label="Toggle Theme">
                    <i class="fa-solid fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" aria-label="Menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="section" style="background-color: var(--color-bg-white); border-bottom: 1px solid var(--color-border); padding: 4rem 0;">
        <div class="container text-center">
            <h1>Our Services</h1>
            <p style="max-width: 600px; margin: 0 auto;">Comprehensive digital solutions to help your business thrive in the modern landscape.</p>
        </div>
    </section>

    <!-- Services Grid -->
    <section class="section">
        <div class="container">
            <div class="grid">
                <div class="card">
                    <i class="fa-solid fa-laptop-code card-icon"></i>
                    <h3>Web Development</h3>
                    <p>We build responsive, fast, and scalable websites using the latest web technologies to ensure optimal performance.</p>
                    <a href="#" class="btn btn-outline" style="margin-top: 1rem;">Learn More</a>
                </div>
                <div class="card">
                    <i class="fa-solid fa-pen-nib card-icon"></i>
                    <h3>UI/UX Design</h3>
                    <p>Our design team creates intuitive, user-centric interfaces that provide exceptional user experiences and boost engagement.</p>
                    <a href="#" class="btn btn-outline" style="margin-top: 1rem;">Learn More</a>
                </div>
                <div class="card">
                    <i class="fa-solid fa-cart-shopping card-icon"></i>
                    <h3>E-Commerce Development</h3>
                    <p>Secure, feature-rich e-commerce platforms tailored to maximize conversions and simplify inventory management.</p>
                    <a href="#" class="btn btn-outline" style="margin-top: 1rem;">Learn More</a>
                </div>
                <div class="card">
                    <i class="fa-solid fa-mobile-screen-button card-icon"></i>
                    <h3>Mobile App Development</h3>
                    <p>Cross-platform and native mobile applications designed to bring your services directly to your customers' fingertips.</p>
                    <a href="#" class="btn btn-outline" style="margin-top: 1rem;">Learn More</a>
                </div>
                <div class="card">
                    <i class="fa-solid fa-magnifying-glass-chart card-icon"></i>
                    <h3>SEO & Digital Marketing</h3>
                    <p>Data-driven marketing strategies and search engine optimization to increase your brand's online visibility.</p>
                    <a href="#" class="btn btn-outline" style="margin-top: 1rem;">Learn More</a>
                </div>
                <div class="card">
                    <i class="fa-solid fa-cloud card-icon"></i>
                    <h3>Cloud Solutions</h3>
                    <p>Reliable and scalable cloud infrastructure setup, migration, and management for seamless business operations.</p>
                    <a href="#" class="btn btn-outline" style="margin-top: 1rem;">Learn More</a>
                </div>
            </div>
        </div>
    </section>

    <!-- How We Work -->
    <section class="section" style="background-color: var(--color-bg-white);">
        <div class="container">
            <div class="text-center" style="margin-bottom: 4rem;">
                <h2>How We Work</h2>
                <p>Our proven development process ensures success from start to finish.</p>
            </div>
            
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-content">
                        <h3>1. Discovery</h3>
                        <p>We start by understanding your business goals, target audience, and project requirements in detail.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <h3>2. Planning</h3>
                        <p>We define the project scope, technical stack, timeline, and create a comprehensive roadmap.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <h3>3. Design</h3>
                        <p>Our designers craft wireframes and high-fidelity prototypes for your approval before development begins.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <h3>4. Development</h3>
                        <p>Our expert developers write clean, efficient code to bring the approved designs to life.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <h3>5. Testing</h3>
                        <p>Rigorous Quality Assurance testing across devices and browsers ensures a bug-free experience.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-content">
                        <h3>6. Launch</h3>
                        <p>We deploy your product to the live environment and provide ongoing support and maintenance.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="logo" style="margin-bottom: 1rem;">
                        <i class="fa-solid fa-code"></i> Devixo Solutions
                    </div>
                    <p>Digital Solutions. Powerful Results.</p>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem;">Quick Links</h4>
                    <ul style="display:flex; flex-direction:column; gap:0.5rem;">
                        <li><a href="/Home/Index">Home</a></li>
                        <li><a href="/Home/About">About Us</a></li>
                        <li><a href="/Home/Services">Services</a></li>
                        <li><a href="/Home/Portfolio">Portfolio</a></li>
                        <li><a href="/Home/Contact">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem;">Contact Info</h4>
                    <ul style="display:flex; flex-direction:column; gap:0.5rem; color:var(--color-text-muted);">
                        <li><i class="fa-solid fa-envelope"></i> hello@devixosolutions.com</li>
                        <li><i class="fa-solid fa-phone"></i> +92 300 1234567</li>
                        <li><i class="fa-solid fa-location-dot"></i> Lahore, Pakistan</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Devixo Solutions. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scroll to Top -->
    <button class="scroll-top" aria-label="Scroll to top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="/js/script.js"></script>
</body>
</html>

